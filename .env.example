# Copy to .env. No credentials here: you log into IB Gateway yourself (PAPER account).
IBKR_HOST=127.0.0.1
IBKR_PORT=4002        # IB Gateway paper = 4002, TWS paper = 7497
IBKR_CLIENT_ID=21     # must be unique per connected API client
IBKR_READONLY=1       # 1 = cannot place orders (keep until you build execution)
